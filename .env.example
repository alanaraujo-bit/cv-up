# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Every variable here must also be declared in src/lib/env.ts.

# Public base URL of the app. Vercel sets this per environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" only for container builds that run without secrets.
# SKIP_ENV_VALIDATION="false"
