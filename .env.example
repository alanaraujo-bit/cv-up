# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Every variable here must also be declared in src/lib/env.ts.

# Public base URL of the app. Vercel sets this per environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Railway PostgreSQL) -----------------------------------------
# Runtime connection. `connection_limit=1` keeps serverless instances from
# exhausting Postgres; `uselibpqcompat=true` is required because Railway uses a
# self-signed certificate and pg >= 8.16 otherwise treats `require` as
# `verify-full`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?connection_limit=1&pool_timeout=20&uselibpqcompat=true&sslmode=require"

# Direct connection, used by migrations and the seed.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?uselibpqcompat=true&sslmode=require"

# --- Authentication --------------------------------------------------------
# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=""

# Optional. Google sign-in stays hidden until both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Object storage --------------------------------------------------------
# Private Vercel Blob store: resume photos and exported PDFs. Never public.
BLOB_READ_WRITE_TOKEN=""

# --- PDF export ------------------------------------------------------------
# Shared secret the PDF renderer authenticates with. Set the *same* value in
# services/pdf-renderer. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Optional: while it is unset, /api/render/* returns 404 and the export button
# is not rendered — no half-working PDF export.
RENDER_WORKER_SECRET=""

# Set to "true" only for container builds that run without secrets.
# SKIP_ENV_VALIDATION="false"
